{
  "name": "@tutti-os/agent-acp-kit",
  "version": "0.7.11",
  "type": "module",
  "description": "ACP-oriented toolkit for detecting, launching, and streaming local coding agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tutti": {
      "types": "./dist/tutti/index.d.ts",
      "import": "./dist/tutti/index.js"
    },
    "./tutti/contracts": {
      "types": "./dist/tutti/contracts.d.ts",
      "import": "./dist/tutti/contracts.js"
    },
    "./runtime-control-plane": {
      "types": "./dist/runtime/control-plane.d.ts",
      "import": "./dist/runtime/control-plane.js"
    },
    "./process-adapter": {
      "types": "./dist/process/process-adapter.d.ts",
      "import": "./dist/process/process-adapter.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build tsconfig.json --force",
    "dev": "tsc --build tsconfig.json --watch --preserveWatchOutput",
    "pack:check": "npm pack --dry-run",
    "test:packed-consumer": "pnpm build && node scripts/test-packed-consumer.mjs",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.34",
      "ip-address": ">=10.2.2",
      "@hono/node-server": ">=2.0.5",
      "fast-uri": ">=3.1.5"
    }
  }
}
